# Serveur
PORT=4317
HOST=127.0.0.1
DATA_DIR=./data

# Accès professeur
ADMIN_PASSWORD=change-me
SESSION_SECRET=

# URL publique (optionnel). Laisser vide : les liens utilisent l'adresse de la requête.
PUBLIC_URL=

# Jev (modération). Laisser vide pour le mode local seul.
JEV_API_KEY=
JEV_MODEL=jev-1.13-free
JEV_ENABLED=true

# Conservation des données (jours)
RETENTION_DAYS=30
